# 统一行尾策略：仓库内一律以 LF 存储，工作区也检出为 LF
# 构建与运行环境以 Linux 容器为主（GitHub Actions ubuntu-latest / Docker），LF 是唯一正确选择
* text=auto eol=lf

# 源码与配置
*.java       text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.properties text eol=lf
*.sql        text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.conf       text eol=lf
*.txt        text eol=lf

# 容器相关：Dockerfile 与 shell 脚本必须 LF
# sql/init.sh 会挂载进 MySQL 容器执行，CRLF 会导致 /bin/sh^M: bad interpreter
Dockerfile*  text eol=lf
*.sh         text eol=lf
.dockerignore text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Windows 脚本保持 CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# 二进制文件不做行尾转换
*.jar        binary
*.war        binary
*.class      binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
*.gz         binary
*.tar        binary
*.pem        binary
